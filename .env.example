# Supabase project settings (Project Settings → API Keys)
# Use the "publishable" key — safe for client bundles, RLS still applies.
# NEVER put the "secret" key here (bypasses RLS, must stay server-side only).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google Cloud project with Places API (New) enabled, key restricted to it
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your-places-api-key

# Dev-only: develop the compass loop on a laptop with no phone/emulator/magnetometer.
# See docs/local-dev-without-a-phone.md. Leave unset/false for normal development.
# EXPO_PUBLIC_MOCK_LOCATION=true
# EXPO_PUBLIC_MOCK_LAT=40.7484
# EXPO_PUBLIC_MOCK_LNG=-73.9857
